{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "neopact": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}/server",
        "--locked",
        "--no-dev",
        "python",
        "${PLUGIN_ROOT}/scripts/launch.py"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
